# Copy this file to .env and fill in real values. Never commit the real .env.

# ---------------- App ----------------
APP_ENV=development
APP_DEBUG=true
APP_SECRET_KEY=change_me_to_a_random_64_char_hex_string

# ---------------- Database (Postgres + pgvector) ----------------
POSTGRES_USER=career_copilot
POSTGRES_PASSWORD=change_me
POSTGRES_DB=career_copilot
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ---------------- Gemini ----------------
# Model names change fast on Google's side - verify current recommended models at
# https://ai.google.dev/gemini-api/docs/models before relying on these defaults.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_GENERATION_MODEL=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=768
# ^ Must exactly match the vector(N) column width in db/init/01_schema.sql.
#   gemini-embedding-001 supports configurable output_dimensionality (768/1536/3072) -
#   768 keeps the index small and fast; only raise it if you need the extra quality
#   and are fine with a slower/larger ANN index.

# ---------------- Auth (multi-user ready) ----------------
JWT_SECRET_KEY=change_me_too_random_hex
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# ---------------- Matching thresholds ----------------
# Tune these after you've run 20-30 real JDs through the matcher and compared
# the verdicts against your own gut feeling.
MATCH_STRONG_THRESHOLD=0.70
MATCH_STRETCH_THRESHOLD=0.45

# ---------------- File storage ----------------
RESUME_STORAGE_DIR=./data/resumes
